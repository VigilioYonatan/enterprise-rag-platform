PORT=3000
DATABASE_URL=postgresql://rag_app:CHANGE_ME@localhost:5432/rag
OIDC_ISSUER=http://localhost:8081/realms/enterprise
OIDC_JWKS_URL=http://localhost:8081/realms/enterprise/protocol/openid-connect/certs
OIDC_AUDIENCE=enterprise-rag-api
OIDC_CLIENT_ID=enterprise-rag-web
OLLAMA_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDINGS_ENABLED=false

# Self-hosted object storage and queue (never use production defaults)
OBJECT_STORAGE_HOST=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_SSL=false
OBJECT_STORAGE_BUCKET=rag-documents
OBJECT_STORAGE_ACCESS_KEY=CHANGE_ME
OBJECT_STORAGE_SECRET_KEY=CHANGE_ME
QUEUE_MODE=bullmq
VALKEY_URL=redis://localhost:6379
VALKEY_PASSWORD=CHANGE_ME
