{
  "name": "enterprise-rag-impl",
  "version": "0.1.0-beta",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build:contracts": "tsc -p packages/contracts/tsconfig.build.json && node scripts/fix-esm-imports.cjs",
    "build": "nest build && tsc-alias -p tsconfig.json && node scripts/copy-sql-assets.cjs",
    "start": "node --require ./dist/observability/tracing.js dist/main.js",
    "worker": "node --require ./dist/observability/tracing.js dist/worker/main.js",
    "outbox": "node --require ./dist/observability/tracing.js dist/outbox/main.js",
    "migration": "node dist/database/migrate.js",
    "platform:setup": "node dist/platform/setup.js",
    "db:seed:local": "tsx src/scripts/seed-local-db.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts openapi.json",
    "openapi:diff": "node scripts/openapi-diff.cjs openapi.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test:type": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts",
    "check": "biome ci src test scripts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "cucumber-js --require-module tsx/cjs --require test/bdd/steps/*.ts test/bdd/features/*.feature"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/auto-instrumentations-node": "0.65.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.206.0",
    "@opentelemetry/resources": "2.2.0",
    "@opentelemetry/sdk-node": "0.206.0",
    "@scalar/nestjs-api-reference": "1.2.35",
    "bullmq": "5.58.5",
    "drizzle-orm": "0.45.4",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jose": "5.10.0",
    "mammoth": "1.9.1",
    "multer": "2.0.2",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.5.0",
    "pdf-parse": "1.1.1",
    "pg": "8.16.3",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tesseract.js": "6.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cucumber/cucumber": "11.3.0",
    "@nestjs/cli": "11.0.10",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "24.9.1",
    "@types/pg": "8.15.6",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.11",
    "tsc-alias": "^1.9.10",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
