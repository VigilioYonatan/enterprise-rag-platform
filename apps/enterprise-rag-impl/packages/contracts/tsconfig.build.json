{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "emitDecoratorMetadata": false,
    "experimentalDecorators": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "../..",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../../src/contracts.ts"],
  "exclude": ["../../dist", "../../node_modules", "../../test", "../../**/*.test.ts"]
}
