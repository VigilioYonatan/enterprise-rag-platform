# Local / Rootless Podman edge proxy (:8080 inside container; mapped to 127.0.0.1:8080 on host).
{
  admin off
  auto_https off
}

{$SITE_ADDRESS::8080} {
  encode zstd gzip

  @api path /api/*
  handle @api {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:8080
  }

  header X-Content-Type-Options "nosniff"
  header Referrer-Policy "strict-origin-when-cross-origin"
  header X-Frame-Options "DENY"
  header Cross-Origin-Opener-Policy "same-origin"
  header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' {$CSP_CONNECT_ORIGIN:http://localhost:8081}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  header -Server
}
