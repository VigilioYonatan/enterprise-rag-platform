{
  "id": null,
  "uid": "enterprise-rag-api",
  "title": "Enterprise RAG · API, FinOps & Worker SLO",
  "schemaVersion": 40,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "rag",
    "slo",
    "self-hosted",
    "podman"
  ],
  "panels": [
    {
      "id": 1,
      "title": "API request rate by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "rag-prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(rag_http_requests_total[5m]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "req/s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 2,
      "title": "API 5xx error ratio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "rag-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rag_http_requests_total{outcome=\"server_error\"}[5m])) / clamp_min(sum(rate(rag_http_requests_total[5m])), 0.001)",
          "refId": "A",
          "legendFormat": "5xx ratio"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 3,
      "title": "API p95 latency by route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "rag-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route)(rate(rag_http_duration_seconds_bucket[5m])))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 4,
      "title": "API memory RSS",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "rag-prometheus" },
      "targets": [
        {
          "expr": "rag_process_resident_memory_bytes",
          "refId": "A",
          "legendFormat": "API RSS"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    },
    {
      "id": 5,
      "title": "FinOps daily budget rejections",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "rag-prometheus" },
      "targets": [
        {
          "expr": "sum(rate(rag_budget_rejections_total[5m]))",
          "refId": "A",
          "legendFormat": "Budget rejections/s"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } }
    }
  ]
}
