# DESARROLLO LOCAL (Rootless Podman / Docker Compose): REEMPLAZAR ANTES DE EXPONER SERVICIOS
POSTGRES_PASSWORD=CHANGE_ME_USE_RANDOM_SECRET
APP_DB_PASSWORD=CHANGE_ME_DISTINCT_APP_DATABASE_PASSWORD
WORKER_DB_PASSWORD=CHANGE_ME_DISTINCT_WORKER_PASSWORD
KEYCLOAK_DB_PASSWORD=CHANGE_ME_DISTINCT_KEYCLOAK_DB_PASSWORD
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_USE_RANDOM_SECRET
KEYCLOAK_ADMIN=kcadmin

VITE_OIDC_AUTHORITY=http://localhost:8081/realms/enterprise
CSP_CONNECT_ORIGIN=http://localhost:8081
VITE_GOOGLE_ENABLED=false
VITE_FACEBOOK_ENABLED=false
WEB_ORIGIN=http://localhost:8080

# RustFS private S3-compatible object storage (Apache-2.0, zero public ports)
RUSTFS_ACCESS_KEY=rag_storage_service
RUSTFS_SECRET_KEY=CHANGE_ME_RANDOM_RUSTFS_SECRET_KEY
RUSTFS_CONSOLE_ENABLE=false

VALKEY_PASSWORD=CHANGE_ME_RANDOM_VALKEY_PASSWORD

# Local AI / Embeddings / Reranker (Ollama self-hosted)
OLLAMA_IMAGE=ollama/ollama:0.12.10
OLLAMA_GENERATION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDINGS_ENABLED=false
RERANKER_ENABLED=false
OLLAMA_RERANKER_MODEL=qwen3-reranker:0.6b
MIN_VECTOR_SIMILARITY=0.25

CLAMAV_REQUIRED=true
CLAMAV_NO_FRESHCLAMD=true
OCR_ENABLED=false

GRAFANA_ADMIN_PASSWORD=CHANGE_ME_USE_RANDOM_SECRET

LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0

# Rootless Podman unprivileged ports (:8080 / :8443)
SITE_ADDRESS=:8080
CADDY_BIND_HTTP=127.0.0.1:8080
CADDY_BIND_HTTPS=127.0.0.1:8443
START_LOCAL_LLM=true
PULL_LOCAL_MODELS=true

# PRODUCTION ONLY: uncomment and configure audited HTTPS domains, real digests and Cosign identity:
# KEYCLOAK_START_MODE=start
# KEYCLOAK_HOSTNAME=https://auth.rag.yourdomain.tld
# OIDC_ISSUER=https://auth.rag.yourdomain.tld/realms/enterprise
# AUTH_SITE_ADDRESS=auth.rag.yourdomain.tld
# CADDYFILE_PATH=../caddy/Caddyfile.prod
# KEYCLOAK_REALM_FILE=../keycloak/realm-enterprise.production.json
# SITE_ADDRESS=rag.yourdomain.tld
# VITE_OIDC_AUTHORITY=https://auth.rag.yourdomain.tld/realms/enterprise
# CSP_CONNECT_ORIGIN=https://auth.rag.yourdomain.tld
# WEB_ORIGIN=https://rag.yourdomain.tld
# RAG_API_IMAGE=ghcr.io/org/enterprise-rag-api@sha256:<64-hex>
# RAG_WEB_IMAGE=ghcr.io/org/enterprise-rag-web@sha256:<64-hex>
# COSIGN_CERT_IDENTITY_REGEXP=^https://github\.com/org/enterprise-rag/.+
# COSIGN_CERT_ISSUER=https://token.actions.githubusercontent.com
# POSTGRES_IMAGE=pgvector/pgvector@sha256:<64-hex>
# KEYCLOAK_IMAGE=quay.io/keycloak/keycloak@sha256:<64-hex>
# VALKEY_IMAGE=valkey/valkey@sha256:<64-hex>
# RUSTFS_IMAGE=rustfs/rustfs@sha256:<64-hex>
# CADDY_IMAGE=caddy@sha256:<64-hex>
# CLAMAV_IMAGE=clamav/clamav@sha256:<64-hex>
# PROMETHEUS_IMAGE=prom/prometheus@sha256:<64-hex>
# ALERTMANAGER_IMAGE=prom/alertmanager@sha256:<64-hex>
# LOKI_IMAGE=grafana/loki@sha256:<64-hex>
# ALLOY_IMAGE=grafana/alloy@sha256:<64-hex>
# GRAFANA_IMAGE=grafana/grafana@sha256:<64-hex>
# OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib@sha256:<64-hex>
# TEMPO_IMAGE=grafana/tempo@sha256:<64-hex>
# OLLAMA_IMAGE=ollama/ollama@sha256:<64-hex>
